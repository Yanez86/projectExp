{
  "name": "projectexp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @exp/client",
    "build": "npm run build -w @exp/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && npm run check -w @exp/client",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "art": "node scripts/build-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
